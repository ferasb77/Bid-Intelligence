# ==============================================================================
# Bid Intelligence — Environment Configuration Template
# Copy this file to .env and configure local keys.
# NEVER commit the actual .env file or real credentials to version control.
# ==============================================================================

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_CUSTOM_HEADERS=

# Live Supabase Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Supabase Auth (Phase 8 remediation package 2) -- the anon/publishable
# key, NOT the service-role key. Safe to embed in a browser-facing client
# by Supabase's own design; used only by auth_client.py for sign-in/
# sign-out/session handling, never for ordinary database access.
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key-here

# Voyage AI Embeddings Configuration (Optional)
VOYAGE_API_KEY=
